# --- Story writing (one is required; Gemini's free tier is enough) ---
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here

# --- YouTube (required) ---
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# --- Optional premium narration (used first when both are set) ---
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here
# ELEVENLABS_TTS_MODEL=eleven_v3

# --- Provider order ---
# Text:   OpenAI -> Gemini
# Voice:  ElevenLabs -> OpenAI -> Gemini -> gTTS (free fallback, no key)
# Images: OpenAI -> Gemini -> styled title cards

# --- Gemini models (defaults shown) ---
# GEMINI_TEXT_MODEL=gemini-3.7-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# --- OpenAI models (defaults shown) ---
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_IMAGE_MODEL=gpt-image-2

# --- Video ---
# AI scene images per episode (0 turns them off)
# SCENE_IMAGE_COUNT=6
