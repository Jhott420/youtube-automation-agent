# Copy to .env and fill in. Never commit .env.

# --- Required ------------------------------------------------------------
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=            # from @BotFather

# --- Claude ---------------------------------------------------------------
# NOTE: claude-sonnet-4-5 is deprecated and retires 2026-11-30.
# Switch to claude-sonnet-5-5 (current Sonnet) before then.
CLAUDE_MODEL=claude-sonnet-4-5
MAX_REPLY_TOKENS=1024
MAX_SUMMARY_TOKENS=1024

# --- Admin HTTP API (uvicorn companion.api:app) -------------------------------
# Long random string; required for every API route except /health.
# e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# --- Access control ------------------------------------------------------------
# Comma-separated Telegram numeric user IDs allowed to chat. Empty = anyone.
TELEGRAM_ALLOWED_USER_IDS=

# --- Storage -------------------------------------------------------------------
DB_PATH=data/companion.db
PERSONA_PATH=config/persona.yaml

# --- Memory --------------------------------------------------------------------
HISTORY_WINDOW=20        # recent messages sent to Claude verbatim
SUMMARIZE_BATCH=20       # summarize once this many older messages accumulate
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.15
EMBEDDER=hashing         # or sentence-transformers (pip install sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Rate limiting -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=300
